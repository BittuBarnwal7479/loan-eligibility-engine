{
  "id": "LoanEngWorkflowB",
  "name": "B - User Matching (multi-stage)",
  "nodes": [
    {
      "parameters": {
        "content": "## Workflow B - optimized matching\nTriggered by the backend after a CSV batch is committed (header **X-Webhook-Token**).\n\n1. Validate the batch id and status.\n2. *(optional)* LLM normalizes free-text **product** criteria once per product, evidence-checked. Skipped unless LLM_ENABLED=true. Never sees user data.\n3. Backend runs, per 1,000-user chunk: **SQL pre-filter** (parameterized join drops pairs that fail any known threshold) -> **deterministic evaluation** with per-criterion reasons -> idempotent upsert. Unknown criteria never count as a pass.\n4. Counters (pairs, SQL survivors, eliminations, matches, LLM calls) are stored in matching_runs.\n5. Triggers Workflow C.",
        "width": 560,
        "height": 320
      },
      "id": "e1aba771-bb03-5bf4-a44f-44fffb3808ff",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        -340
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "loan-matching",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "df5da62c-c4be-5f2e-9cdd-b27fad9422de",
      "name": "Upload completed webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "LoanEngWebhook01",
          "name": "Loan Engine Webhook Token (X-Webhook-Token)"
        }
      },
      "webhookId": "fbd48589-b0a1-56e3-9b05-7ed82c45ced5"
    },
    {
      "parameters": {
        "jsCode": "// Accept only a UUID batch id from the webhook body; reject anything else.\nconst body = $json.body || {};\nconst id = String(body.upload_batch_id || '');\nif (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id)) {\n  throw new Error('upload_batch_id missing or not a UUID');\n}\nreturn [{ json: { upload_batch_id: id, received_at: new Date().toISOString() } }];"
      },
      "id": "c934db40-ddf7-5962-8947-e4f683a310ad",
      "name": "Validate payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.LOAN_API_BASE_URL || 'http://api:8000') + '/internal/batches/' + $json.upload_batch_id }}",
        "options": {
          "timeout": 120000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "2a3fc79f-2b49-5713-8f36-4b06540a89c0",
      "name": "Get upload batch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "LoanEngInternal1",
          "name": "Loan Engine Internal API (X-Internal-Token)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "7bb27b13-96c1-532d-be14-658c3291ec0e",
              "leftValue": "={{ $json.ready_for_matching }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "ff8a34fc-66fb-5071-91b8-d7bbe978ef47",
      "name": "Batch ready?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "errorMessage": "={{ 'Upload batch ' + $json.upload_batch_id + ' is ' + $json.status + '; matching skipped' }}"
      },
      "id": "c883a698-dc3e-53b2-8a95-92c3ed807d13",
      "name": "Stop: batch not ready",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        880,
        160
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.LOAN_API_BASE_URL || 'http://api:8000') + '/internal/matching/' + $('Validate payload').item.json.upload_batch_id + '/normalize-criteria' }}",
        "options": {
          "timeout": 120000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "3798e1cd-e2de-5133-8309-6a9de4cbde6b",
      "name": "Stage 0 - normalize ambiguous product criteria (optional LLM)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        -80
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "LoanEngInternal1",
          "name": "Loan Engine Internal API (X-Internal-Token)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.LOAN_API_BASE_URL || 'http://api:8000') + '/internal/matching/' + $('Validate payload').item.json.upload_batch_id + '/run' }}",
        "options": {
          "timeout": 900000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ llm_invocations: $json.llm_invocations || 0 }) }}"
      },
      "id": "505749da-9a1f-5d23-bb6d-ebd189251642",
      "name": "Stages 1-3 - SQL pre-filter, deterministic evaluation, persist",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        -80
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "LoanEngInternal1",
          "name": "Loan Engine Internal API (X-Internal-Token)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "const s = $json;\nconst pct = (a, b) => b ? Math.round(1000 * a / b) / 10 : 0;\nreturn [{ json: { upload_batch_id: s.upload_batch_id, matching_run_id: s.matching_run_id,\n  users: s.users_considered, products: s.active_products, possible_pairs: s.total_possible_pairs,\n  sql_candidates: s.sql_candidate_pairs, sql_eliminated_pct: pct(s.sql_eliminated_pairs, s.total_possible_pairs),\n  deterministic_rejections: s.deterministic_rejections, eligible: s.eligible_matches,\n  potential: s.potential_matches, llm_invocations: s.llm_invocations } }];"
      },
      "id": "fd31b41e-6cfc-579e-9f17-4368aba80ce6",
      "name": "Optimization summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        -80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.N8N_SELF_BASE_URL || 'http://localhost:5678') + '/webhook/loan-notify' }}",
        "options": {
          "timeout": 30000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event: 'matching.completed', upload_batch_id: $json.upload_batch_id }) }}"
      },
      "id": "25353398-85da-50c3-b468-7d58b71b0970",
      "name": "Trigger notification workflow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
