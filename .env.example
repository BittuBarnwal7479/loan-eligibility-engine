# Copy to .env and replace every change-me value. Never commit .env.
# Generate random values with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Use URL-safe characters for POSTGRES_PASSWORD (it is embedded in a connection URL).

# --- PostgreSQL (local container) ---
POSTGRES_DB=loan_engine
POSTGRES_USER=loan_engine
POSTGRES_PASSWORD=change-me

# --- Shared secrets between backend and n8n ---
# Backend -> n8n: header X-Webhook-Token on the matching/notification webhooks
N8N_WEBHOOK_TOKEN=change-me
# n8n -> backend: header X-Internal-Token on /internal/* endpoints
INTERNAL_API_TOKEN=change-me
# HMAC key for local-mode upload URLs
UPLOAD_SIGNING_SECRET=change-me
# n8n credential encryption key. Keep it stable: changing it makes saved n8n credentials unreadable.
N8N_ENCRYPTION_KEY=change-me

# --- Notifications ---
# dry_run = nothing is sent (logged as DRY_RUN); smtp = local Mailpit catcher; ses = AWS SES (cloud)
NOTIFICATION_MODE=smtp
# Every email goes to this address only. Use an inbox you control. CSV addresses are never used.
NOTIFICATION_TEST_RECIPIENT=your-test-inbox@example.com
NOTIFICATION_FROM_EMAIL=loan-engine@localhost.test
# Max emails one Workflow C run sends (1-200). Use 1 for a demo; the rest of the batch stays PENDING.
NOTIFICATION_MAX_PER_RUN=200

# --- Optional LLM step (off by default; the pipeline is complete without it) ---
LLM_ENABLED=false
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# --- Host ports (all bound to 127.0.0.1) ---
API_HOST_PORT=8081
FRONTEND_HOST_PORT=5173
POSTGRES_HOST_PORT=5433
MAILPIT_UI_HOST_PORT=8026
TIMEZONE=Asia/Kolkata
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=